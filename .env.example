DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=pg
DB_TIMEZONE=America/Sao_Paulo

PORT=5000

JWT_SECRET=token_secreto
JWT_EXPIRES_IN=1d

// Configurações do Google OAuth
// As credenciais do Google OAuth podem ser obtidas no console de desenvolvedores do Google (https://console.developers.google.com/)
// Configure o Google OAuth para permitir login com contas do Google. Certifique-se de configurar o URI de redirecionamento corretamente para o seu ambiente de desenvolvimento.

GOOGLE_CLIENT_ID=client_id_google
GOOGLE_CLIENT_SECRET=client_secret_google
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Configuracoes de email
HOST_EMAIL=smtp.exemplo.com
PORT_EMAIL=587
SECURE_EMAIL=false
EMAIL_USER=seu_email
EMAIL_PASS=sua_senha_ou_app_password

APP_URL=http://localhost:5000
